{
  "version": 1,
  "note": "打包清单。源码包 = Git 跟踪文件（当前工作树内容）+ extraSourceFiles；免安装包 = portable 段。deny / privatePaths 里的路径一律不进任何包。",
  "extraSourceFiles": [
    "runtime.ps1",
    "restore.ps1",
    "maintenance.ps1",
    "release-files.json",
    "tools/build-release.ps1",
    "tools/test-maintenance.ps1",
    "tools/test-portable.ps1",
    "USAGE.md",
    "DEVELOPMENT.md",
    "tools/release-version.mjs",
    "tools/test-release-version.mjs",
    "tools/test-portable-live.ps1",
    "tools/test-data-preservation.mjs",
    "tools/test-sync-preservation-ui.mjs",
    "public/js/util/kb-guard.js"
  ],
  "deny": [
    "config.json",
    "local.env.ps1",
    "runtime-options.json",
    ".env",
    ".env.*",
    "data",
    "papers",
    "backups",
    "node_modules",
    "output",
    "tmp",
    "temp",
    ".git",
    "*.pem",
    "*.pem.bak",
    "*.keystore",
    "*.jks",
    "*.p12",
    "*.pfx",
    "*.key",
    "*.crt",
    "*.cer",
    "keystore.properties",
    "local.properties"
  ],
  "privatePaths": [
    "config.json",
    "local.env.ps1",
    "runtime-options.json",
    "data",
    "papers",
    "backups",
    ".git",
    "*.pem",
    "*.pem.bak",
    "*.keystore",
    "*.jks",
    "*.p12",
    "*.pfx",
    "*.key",
    "*.crt",
    "*.cer",
    "keystore.properties",
    "local.properties"
  ],
  "portableForbidden": [
    "app",
    "tools/test-*",
    ".github",
    "docs"
  ],
  "portable": {
    "files": [
      "server.js",
      "package.json",
      "package-lock.json",
      "config.example.json",
      "LICENSE",
      "README.md",
      "lib.ps1",
      "control-ui.ps1",
      "backup.ps1",
      "restore.ps1",
      "maintenance.ps1",
      "first-run.ps1",
      "runtime.ps1",
      "start.bat",
      "launch.vbs",
      "release-files.json",
      "assets/icon.ico",
      "assets/icon-256.png",
      "assets/icon-512.png",
      "control.ps1",
      "make-shortcut.ps1",
      "USAGE.md",
      "DEVELOPMENT.md"
    ],
    "directories": [
      "public",
      "lib",
      "assets/screenshots"
    ],
    "tools": [
      "tools/first-run.mjs",
      "tools/pair-qr-png.mjs",
      "tools/print-pair-qr.mjs",
      "tools/qrcode-loader.mjs",
      "tools/preflight.mjs",
      "tools/release-version.mjs"
    ],
    "requiredEntries": [
      "server.js",
      "package.json",
      "package-lock.json",
      "public/index.html",
      "lib.ps1",
      "control-ui.ps1",
      "backup.ps1",
      "restore.ps1",
      "maintenance.ps1",
      "first-run.ps1",
      "runtime.ps1",
      "config.example.json",
      "LICENSE",
      "README.md",
      "assets/icon.ico",
      "runtime/node.exe",
      "runtime/LICENSE",
      "node_modules/qrcode/package.json",
      "lib/json-transactions.js",
      "lib/kb-files.js",
      "lib/sync-debounce.js",
      "control.ps1"
    ]
  },
  "source": {
    "requiredEntries": [
      "package.json",
      "package-lock.json",
      "server.js",
      "public/index.html",
      "lib.ps1",
      "control-ui.ps1",
      "backup.ps1",
      "restore.ps1",
      "maintenance.ps1",
      "first-run.ps1",
      "runtime.ps1",
      "README.md",
      "LICENSE"
    ]
  }
}
